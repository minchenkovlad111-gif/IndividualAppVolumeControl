<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/notif_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Per-app volume"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:shadowColor="#000000"
            android:shadowRadius="2"
            android:shadowDx="0"
            android:shadowDy="0" />

        <TextView
            android:id="@+id/notif_open_overlay"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="Overlay"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:shadowColor="#000000"
            android:shadowRadius="2"
            android:shadowDx="0"
            android:shadowDy="0"
            android:background="@drawable/notif_button" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap +/- or quick presets"
        android:textSize="11sp"
        android:textColor="#FFFFFF"
        android:shadowColor="#000000"
        android:shadowRadius="2"
        android:shadowDx="0"
        android:shadowDy="0"
        android:paddingBottom="6dp" />

    <LinearLayout
        android:id="@+id/notif_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/notif_row_1_main"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/notif_app_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="App"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:shadowColor="#000000"
                android:shadowRadius="2"
                android:shadowDx="0"
                android:shadowDy="0" />

            <TextView
                android:id="@+id/notif_value_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100%"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:shadowColor="#000000"
                android:shadowRadius="2"
                android:shadowDx="0"
                android:shadowDy="0"
                android:paddingEnd="6dp"
                android:paddingRight="6dp" />

            <TextView
                android:id="@+id/notif_minus_1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="-"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:shadowColor="#000000"
                android:shadowRadius="2"
                android:shadowDx="0"
                android:shadowDy="0"
                android:background="@drawable/notif_button" />

            <TextView
                android:id="@+id/notif_plus_1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:gravity="center"
                android:text="+"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                android:shadowColor="#000000"
                android:shadowRadius="2"
                android:shadowDx="0"
                android:shadowDy="0"
                android:background="@drawable/notif_button" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/notif_row_1_quick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/notif_mute_1"
                android:layout_width="48dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="Mute"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:shadowColor="#000000"
                android:shadowRadius="2"
                android:shadowDx="0"
                android:shadowDy="0"
                android:background="@drawable/notif_button" />

            <TextView
                android:id="@+id/notif_25_1"
                android:layout_width="36dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:gravity="center"
                android:text="25%"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:shadowColor="#000000"
                android:shadowRadius="2"
                android:shadowDx="0"
                android:shadowDy="0"
                android:background="@drawable/notif_button" />

            <TextView
                android:id="@+id/notif_50_1"
                android:layout_width="36dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:gravity="center"
                android:text="50%"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:shadowColor="#000000"
                android:shadowRadius="2"
                android:shadowDx="0"
                android:shadowDy="0"
                android:background="@drawable/notif_button" />

            <TextView
                android:id="@+id/notif_75_1"
                android:layout_width="36dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:gravity="center"
                android:text="75%"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:shadowColor="#000000"
                android:shadowRadius="2"
                android:shadowDx="0"
                android:shadowDy="0"
                android:background="@drawable/notif_button" />

            <TextView
                android:id="@+id/notif_100_1"
                android:layout_width="40dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:layout_marginLeft="4dp"
                android:gravity="center"
                android:text="100"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:shadowColor="#000000"
                android:shadowRadius="2"
                android:shadowDx="0"
                android:shadowDy="0"
                android:background="@drawable/notif_button" />
        </LinearLayout>
    </LinearLayout>

